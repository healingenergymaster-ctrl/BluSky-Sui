{
  "name": "blusky-sui",
  "version": "1.0.0",
  "description": "Autonomous CLMM Liquidity Vaults & PTB Execution Protocol on Sui Network",
  "type": "module",
  "scripts": {
    "start": "node --import ./src/compat/suiClientHook.mjs src/index.mjs",
    "start:prod": "node src/start_production.mjs",
    "web": "node --import ./src/compat/suiClientHook.mjs src/server.mjs",
    "server": "node --import ./src/compat/suiClientHook.mjs src/server.mjs",
    "monitor": "node --import ./src/compat/suiClientHook.mjs src/index.mjs",
    "monitor:once": "node --import ./src/compat/suiClientHook.mjs src/index.mjs --once",
    "simulate:drift": "node --import ./src/compat/suiClientHook.mjs src/index.mjs --simulate-drift",
    "simulate:hedge": "node --import ./src/compat/suiClientHook.mjs src/index.mjs --simulate-hedge",
    "vault": "node --import ./src/compat/suiClientHook.mjs src/index.mjs --vault",
    "test:sui": "node --import ./src/compat/suiClientHook.mjs src/test_connection.mjs",
    "test:mainnet": "node --import ./src/compat/suiClientHook.mjs src/test_connection.mjs",
    "test:testnet": "node --import ./src/compat/suiClientHook.mjs src/test_connection.mjs --testnet",
    "testnet:wallet": "node --import ./src/compat/suiClientHook.mjs scripts/setup_testnet_wallet.mjs",
    "testnet:publish": "node --import ./src/compat/suiClientHook.mjs scripts/publish_testnet.mjs",
    "demo:cetus": "node --import ./src/compat/suiClientHook.mjs scripts/run_cetus_rebalance_demo.mjs"
  },
  "dependencies": {
    "@bluefin-exchange/pro-sdk": "^2.4.0",
    "@cetusprotocol/cetus-sui-clmm-sdk": "^5.4.0",
    "@mysten/sui": "^2.38.0",
    "bignumber.js": "^9.1.2",
    "dotenv": "^16.4.5",
    "tslib": "^2.9.1",
    "turbos-clmm-sdk": "^4.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
