{
  "name": "blusky-sui",
  "version": "1.0.0",
  "description": "Autonomous CLMM Liquidity Vaults & PTB Execution Protocol on Sui Network",
  "type": "module",
  "scripts": {
    "start": "node src/index.mjs",
    "web": "node src/server.mjs",
    "server": "node src/server.mjs",
    "monitor": "node src/index.mjs",
    "monitor:once": "node src/index.mjs --once",
    "simulate:drift": "node src/index.mjs --simulate-drift",
    "simulate:hedge": "node src/index.mjs --simulate-hedge",
    "vault": "node src/index.mjs --vault",
    "test:sui": "node src/test_connection.mjs",
    "test:mainnet": "node src/test_connection.mjs",
    "test:testnet": "node src/test_connection.mjs --testnet",
    "testnet:wallet": "node scripts/setup_testnet_wallet.mjs",
    "testnet:publish": "node scripts/publish_testnet.mjs"
  },
  "dependencies": {
    "@cetusprotocol/cetus-sui-clmm-sdk": "^5.4.0",
    "@mysten/sui": "^2.38.0",
    "bignumber.js": "^9.1.2",
    "dotenv": "^16.4.5",
    "tslib": "^2.9.1",
    "turbos-clmm-sdk": "^4.0.2"
  }
}
