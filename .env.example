# Sui Network Configuration
SUI_NETWORK=mainnet
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
SUI_FALLBACK_RPC=https://sui-mainnet-rpc.allthatnode.com

# Bot Execution Mode: DRY_RUN (safe simulation) or LIVE (real transactions)
EXECUTION_MODE=DRY_RUN

# Wallet Credentials (Phase 1 Bot)
# Accepts bech32 (suiprivkey...), 64-char hex, or 32-byte base64
SUI_PRIVATE_KEY=your_private_key_here

# Target Position NFT (Optional: leave empty to auto-detect all SUI/USDC positions)
TARGET_POSITION_NFT=

# Target Pools
TURBOS_SUI_USDC_POOL=0x5eb2dfcdd1b1552029717180891a9019a77212783a03460e536452f45f95b6ec
BLUEFIN_SUI_USDC_POOL=

# Rebalancing Parameters
DRIFT_THRESHOLD_PCT=15
TARGET_BAND_WIDTH_PCT=10
MIN_FEES_BEFORE_REBALANCE_USD=10.0
MAX_COST_TO_FEE_RATIO=0.20
MAX_SLIPPAGE_PCT=0.5
CHECK_INTERVAL_MS=30000
